# Postgres connection string.
#
# Any provider works. The quickest free option is Neon (neon.tech) — create a
# project, copy the POOLED connection string, paste it here.
#
#   Neon      postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#   Supabase  postgresql://postgres.xxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
#   Local     postgresql://bid@localhost:5432/bid
#
# Use the POOLED endpoint in production — serverless functions open many short
# connections and will exhaust a direct endpoint's limit.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs session cookies. Generate a real one before deploying:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-secret-change-me-before-deploying"
