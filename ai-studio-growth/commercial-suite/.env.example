# ───────── Core (required) ─────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/commercial_suite?schema=public"
# 32+ random characters, e.g. `openssl rand -hex 32`. Signs PDF render tokens.
SESSION_SECRET=""
# First administrator, created by `npm run db:seed` if it does not exist.
# If SEED_ADMIN_PASSWORD is empty a random password is generated and printed once.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
# Set to "false" to seed only base configuration (no sample documents)
SEED_SAMPLE_DATA="true"

# ───────── PDF engine ─────────
# Path to a Chromium/Chrome executable used for HTML→PDF rendering
CHROMIUM_PATH="/usr/bin/chromium"
# URL the server uses to reach itself for rendering (defaults to http://127.0.0.1:$PORT)
INTERNAL_APP_URL=""

# ───────── Public URL ─────────
# Public HTTPS base URL. Needed for WhatsApp webhooks and secure short-lived document links.
PUBLIC_APP_URL=""
# Only for local HTTP testing of a production build. Never set in real deployments.
# INSECURE_COOKIES="true"

# ───────── Brevo transactional email ─────────
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Infinitia Hub × AI Studio Craft"
BREVO_REPLY_TO=""
# "live" (default) or "mock". Mock logs emails as Prepared without sending; ignored in production.
EMAIL_DELIVERY_MODE="live"

# ───────── WhatsApp Business Platform (Cloud API) ─────────
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# ───────── Tests ─────────
# Separate database for integration tests (tables are cleared by the tests)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/commercial_suite_test?schema=public"
