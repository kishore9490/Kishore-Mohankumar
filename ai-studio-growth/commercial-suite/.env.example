# Local configuration. Easiest: run `npm run setup -- "<DATABASE_URL>"` which writes this file for you.

# MySQL / MariaDB connection string (e.g. a Hostinger database). Password: letters and numbers only.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"

# 32+ random characters (e.g. `openssl rand -hex 32`). MUST STAY THE SAME once set:
# it encrypts MFA secrets and the integration credentials entered in Settings.
SESSION_SECRET=""
# Optional dedicated encryption key (defaults to SESSION_SECRET). Same rule: never change it.
# ENCRYPTION_KEY=""

# First administrator — created as an invitation by `npm run db:seed` (no password is ever seeded)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Administrator"
# Set to "false" to skip sample documents
SEED_SAMPLE_DATA="true"

# Chrome / Chromium / Edge executable for PDFs (auto-detected). If none is found on Linux, a bundled
# Chromium (@sparticuz/chromium) is used automatically. PDF_ENGINE="bundled" forces the bundled one.
CHROMIUM_PATH=""

# Base URL printed in invitation links from the CLI (the app also has a Public URL setting)
APP_URL="http://localhost:3000"

# ───────── Hosting (see DEPLOY-HOSTINGER.md) ─────────
# Public https address of the app
# PUBLIC_APP_URL="https://quote.aistudiocraft.in"
# Optional remote Chrome for PDFs if the host blocks the bundled Chromium (e.g. Browserless)
# BROWSER_WS_ENDPOINT="wss://production-sfo.browserless.io?token=YOUR_TOKEN"
# One-time first-admin setup at /setup (16+ characters; only works while no user exists)
# SETUP_TOKEN=""

# Email (Brevo) is configured inside the app: Settings → Integrations. WhatsApp: tools/whatsapp-sender (Python).
# Credentials entered there are stored encrypted in the database.

# Only for testing a production build over plain http on your own machine. Never in real deployments.
# INSECURE_COOKIES="true"

# Separate database for integration tests (its tables are cleared by the tests)
TEST_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/quote_studio_test"
