# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# WhatsApp number in international format, digits only (e.g. 9198XXXXXXXX).
# When empty, WhatsApp actions fall back to the on-site counselling form.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Show clearly-marked placeholder content (faculty, etc.). Never enable in production.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# Optional: CRM / automation webhook that receives demo, counselling and enquiry leads (server-side only).
LEADS_WEBHOOK_URL=
