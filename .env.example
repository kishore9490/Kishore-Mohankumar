# ─────────────────────────────────────────────────────────────
# EMC — environment variables (placeholders only, never commit real values)
# Everything here is read on the server. Only NEXT_PUBLIC_* reaches the browser.
# ─────────────────────────────────────────────────────────────

# Public website
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false
# Optional mirror of website leads to an external CRM/automation tool
LEADS_WEBHOOK_URL=

# Platform core
# Leave DATABASE_URL empty to run in demo mode (in-memory, fictional data, demo logins).
DATABASE_URL=
# 32+ random characters. Required in production.
AUTH_SECRET=

# Provider selection (adapters live in /integrations; business code never names a provider)
EMAIL_PROVIDER=simulated        # simulated | brevo | sendgrid | ses | msgraph | smtp
WHATSAPP_PROVIDER=simulated     # simulated | meta_cloud | bsp
SMS_PROVIDER=simulated          # simulated | msg91 | twilio
AI_PROVIDER=none                # none | openai | gemini | anthropic
STORAGE_PROVIDER=demo           # demo | s3 | r2 | azure
PAYMENT_PROVIDER=none           # none | razorpay | stripe
ANALYTICS_PROVIDER=internal     # internal

# Email
EMAIL_FROM=
BREVO_API_KEY=
SENDGRID_API_KEY=
AWS_SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# WhatsApp Business
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_BASE_URL=
WHATSAPP_WEBHOOK_SECRET=

# SMS
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_SENDER_ID=

# AI (always human-reviewed; never medical advice)
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
